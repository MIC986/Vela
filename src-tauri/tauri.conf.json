{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vela",
  "version": "1.0.1",
  "identifier": "com.vela.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Vela",
    "copyright": "Copyright © 2026 the Vela contributors. Apache License 2.0.",
    "category": "Game",
    "shortDescription": "Every game on your PC, in one place that feels like a console.",
    "longDescription": "Vela finds the games from every launcher on your PC and puts them in one fast, controller-friendly place.",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
